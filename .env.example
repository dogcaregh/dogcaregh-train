# DogTrainerGH — environment variables (NAMES ONLY; never commit real values)
# Shares the DogCareGH Supabase project — copy the SAME url + anon key.

# ── Public (inlined at build time — set for EVERY Vercel environment) ─────────
NEXT_PUBLIC_SUPABASE_URL=            # same Supabase project URL as DogCareGH
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # same anon key as DogCareGH
NEXT_PUBLIC_SITE_URL=https://train.dogcaregh.com   # prod origin (used in emails + Paystack callback)

# ── Server-only (never exposed to the browser) ───────────────────────────────
# Service role key. Used by the daily reminder cron (bypasses RLS) and the
# payment callback. Without it, the cron no-ops.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (reuses DogCareGH's Paystack account — same secret key). When UNSET,
# checkout is stubbed: evaluations/bookings are auto-marked paid so the flow
# stays testable in preview. Set the real key to take live payments.
PAYSTACK_SECRET_KEY=

# Resend — transactional email for notifications. Optional: when unset,
# in-app notifications still work; only the emailed copy is skipped.
RESEND_API_KEY=

# Vercel Cron auth. When set, /api/cron/session-reminders requires
# `Authorization: Bearer <CRON_SECRET>`. Optional but recommended in prod.
CRON_SECRET=
